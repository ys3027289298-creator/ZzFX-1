[8.368, "o", "┌─────────┬───────────────────┬──────────┬──────────┬─────────────┬────────────────┬──────────────────┬──────────────┬──────────────────┬──────────────────┬───────────────┬────────────────┬────────┐\r\n│ (index) │       name        │ len44100 │ len48000 │ durationSec │ durationDiffMs │ centroidDriftPct │ envelopeCorr │ peakPitch44100Hz │ peakPitch48000Hz │ pitchDriftPct │ alignedRmsePct │ result │\r\n├─────────┼───────────────────┼──────────┼──────────┼─────────────┼────────────────┼──────────────────┼──────────────┼──────────────────┼──────────────────┼───────────────┼────────────────┼────────┤\r\n│    0    │    'sine_blip'    │   7056   │   7680   │  '0.1600'   │    '0.000'     │     '0.046'      │      1       │     '430.7'      │     '430.7'      │    '0.000'    │    '0.002'     │ 'PASS' │\r\n│    1    │    'saw_slide'    │  10363   │  11280   │  '0.2350'   │    '0.011'     │     '1.816'      │      1       │     '387.6'      │     '387.6'      │    '1.116'    │                │ 'PASS' │\r\n│    2    │   'square_jump'   │  10143   │  11040   │  '0.2300'   │    '0.000'     │     '1.719'      │      1       │     '1098.2'     │     '1098.2'     │    '0.005'    │                │ 'PASS' │\r\n│    3    │ 'triangle_repeat' │  11025   │  12000   │  '0.2500'   │    '0.000'     │     '1.678'      │      1       │     '516.8'      │     '516.8'      │    '0.000'    │    '0.180'     │ 'PASS' │\r\n│    4    │    'noise_hit'    │   7056   │   7680   │  '0.1600'   │    '0.000'     │     '2.169'      │    0.9998    │                  │                  │               │                │ 'PASS' │\r\n│    5    │  'tan_mod_crush'  │  11025   │  12000   │  '0.2500'   │    '0.000'     │     '0.218'      │    0.9991    │                  │                  │               │                │ 'PASS' │\r\n│    6    │ 'delayed_filter'  │  20506   │  22320   │  '0.4650'   │    '0.011'     │     '0.000'      │      1       │     '1571.9'     │     '1571.9'     │    '0.746'    │                │ 'PASS' │\r\n│    7    │  'tremolo_full'   │  18522   │  20160   │  '0.4200'   │    '0.000'     │     '0.000'      │    0.9996    │     '925.9'      │     '904.4'      │    '0.841'    │                │ 'PASS' │\r\n│    8    │  'default_tone'   │   4419   │   4809   │  '0.1002'   │    '0.017'     │     '0.511'      │      1       │     '215.3'      │     '215.3'      │    '0.000'    │    '0.114'     │ 'PASS' │\r\n│    9    │   'randomized'    │  12348   │  13440   │  '0.2800'   │    '0.000'     │     '0.834'      │    0.9865    │                  │                  │               │                │ 'PASS' │\r\n│   10    │    'defaults'     │   4419   │   4809   │  '0.1002'   │    '0.017'     │     '5.734'      │    0.9949    │                  │                  │               │                │ 'PASS' │\r\n└─────────┴───────────────────┴──────────┴──────────┴──"]
