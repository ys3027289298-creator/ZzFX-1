[0.008, "o", "\r\n############################################################\r\n# SEGMENT 1/4  Code change: sample rate is now a parameter\r\n############################################################\r\n"]
[0.609, "o", "\u001b[1mdiff --git a/ZzFX.js b/ZzFX.js\u001b[m\r\n\u001b[1mindex 7037041..b23fa85 100644\u001b[m\r\n\u001b[1m--- a/ZzFX.js\u001b[m\r\n\u001b[1m+++ b/ZzFX.js\u001b[m\r\n\u001b[36m@@ -121,12 +121,13 @@\u001b[m \u001b[mexport const ZZFX =\u001b[m\r\n         sustainVolume = 1,\u001b[m\r\r\n         decay = 0,\u001b[m\r\r\n         tremolo = 0,\u001b[m\r\r\n\u001b[31m-        filter = 0\u001b[m\r\r\n\u001b[32m+\u001b[m\u001b[32m        filter = 0,\u001b[m\u001b[41m\r\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        sampleRate = this.sampleRate\u001b[m\u001b[41m\r\u001b[m\r\n     )\u001b[m\r\r\n     {\u001b[m\r\r\n\u001b[31m-        // init parameters\u001b[m\r\r\n\u001b[31m-        let sampleRate = this.sampleRate,\u001b[m\r\r\n\u001b[31m-            PI2 = Math.PI*2, \u001b[m\r\r\n\u001b[32m+\u001b[m\u001b[32m        // init parameters; all user-facing time parameters are in seconds and\u001b[m\u001b[41m\r\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        // only converted to sample counts/per-sample deltas below\u001b[m\u001b[41m\r\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        let PI2 = Math.PI*2,\u001b[m\u001b[41m \r\u001b[m\r\n             abs = Math.abs, \u001b[m\r\r\n             sign = v => v<0?-1:1, \u001b[m\r\r\n             startSlide = slide *= 500 * PI2 / sampleRate / sampleRate,\u001b[m\r\r\n\u001b[36m@@ -138,12 +139,12 @@\u001b[m \u001b[mexport const ZZFX =\u001b[m\r\n             jump = 1,      // pitch jump timer\u001b[m\r\r\n             length,        // sample length\u001b[m\r\r\n             b,             // sample buffer\u001b[m\r\r\n\u001b[31m-            t = 0,         // sample time\u001b[m\r\r\n\u001b[32m+\u001b[m\u001b[32m            t = 0,         // phase accumulator (radians)\u001b[m\u001b[41m\r\u001b[m\r\n"]
[0.000, "o", "             i = 0,         // sample index \u001b[m\r\r\n             s = 0,         // sample value\u001b[m\r\r\n         f,             // wave frequency\u001b[m\r\r\n \u001b[m\r\r\n\u001b[31m-        // biquad LP/HP filter\u001b[m\r\r\n\u001b[32m+\u001b[m\u001b[32m        // biquad LP/HP filter coefficients (w is radians per sample)\u001b[m\u001b[41m\r\u001b[m\r\n         quality = 2, w = PI2 * abs(filter) * 2 / sampleRate,\u001b[m\r\r\n         cos = Math.cos(w), alpha = Math.sin(w) / 2 / quality,\u001b[m\r\r\n         a0 = 1 + alpha, a1 = -2*cos / a0, a2 = (1 - alpha) / a0,\u001b[m\r\r\n\u001b[36m@@ -151,8 +152,9 @@\u001b[m \u001b[mexport const ZZFX =\u001b[m\r\n         b1 = -(sign(filter) + cos) / a0, b2 = b0,\u001b[m\r\r\n         x2 = 0, x1 = 0, y2 = 0, y1 = 0;\u001b[m\r\r\n \u001b[m\r\r\n\u001b[31m-        // scale by sample rate\u001b[m\r\r\n\u001b[31m-        const minAttack = 9; // prevent pop if attack is 0\u001b[m\r\r\n"]
[0.000, "o", "\u001b[32m+\u001b[m\u001b[32m        // All envelope/timing parameters arrive in seconds. Convert them once\u001b[m\u001b[41m\r\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        // here into sample counts for the output layer.\u001b[m\u001b[41m\r\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const minAttack = 9; // samples, prevent pop if attack is 0\u001b[m\u001b[41m\r\u001b[m\r\n         attack = attack * sampleRate || minAttack;\u001b[m\r\r\n         decay *= sampleRate;\u001b[m\r\r\n         sustain *= sampleRate;\u001b[m\r\r\n\u001b[36m@@ -161,11 +163,15 @@\u001b[m \u001b[mexport const ZZFX =\u001b[m\r\n         deltaSlide *= 500 * PI2 / sampleRate**3;\u001b[m\r\r\n         modulation *= PI2 / sampleRate;\u001b[m\r\r\n         pitchJump *= PI2 / sampleRate;\u001b[m\r\r\n\u001b[31m-        pitchJumpTime *= sampleRate;\u001b[m\r\r\n\u001b[31m-        repeatTime = repeatTime * sampleRate | 0;\u001b[m\r\r\n\u001b[32m+\u001b[m\u001b[32m        pitchJumpTime = pitchJumpTime * sampleRate | 0; // samples\u001b[m\u001b[41m\r\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        repeatTime = repeatTime * sampleRate | 0;      // samples\u001b[m\u001b[41m\r\u001b[m\r\n\u001b[32m+\u001b[m\u001b[41m\r\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        // total duration in seconds; the output layer converts it to samples\u001b[m\u001b[41m\r\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const durationSeconds =\u001b[m\u001b[41m\r\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            (attack + decay + sustain + release + delay) / sampleRate;\u001b[m\u001b[41m\r\u001b[m\r\n \u001b[m\r\r\n         // allocate the full sample buffer up front, much faster than growing an array\u001b[m\r\r\n\u001b[31m-        length = attack + decay + sustain + release + delay | 0;\u001b[m\r\r\n\u001b[32m+\u001b[m\u001b[32m        length = durationSeconds * sampleRate | 0;\u001b[m\u001b[41m\r\u001b[m\r\n         b = new Float32Array(length > 0 ? length : 0);\u001b[m\r\r\n \u001b[m\r\r\n         // generate waveform\u001b[m\r\r\n"]
[0.000, "o", "\u001b[1mdiff --git a/package.json b/package.json\u001b[m\r\n\u001b[1mindex cde6200..83ab51f 100644\u001b[m\r\n\u001b[1m--- a/package.json\u001b[m\r\n\u001b[1m+++ b/package.json\u001b[m\r\n\u001b[36m@@ -2,6 +2,7 @@\u001b[m\r\n   \"name\": \"zzfx\",\u001b[m\r\n   \"version\": \"1.4.0\",\u001b[m\r\n   \"description\": \"A Tiny JavaScript Sound FX System\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"type\": \"module\",\u001b[m\r\n   \"main\": \"ZzFX.js\",\u001b[m\r\n   \"files\": [\u001b[m\r\n     \"ZzFX.js\",\u001b[m\r\n"]
